# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
# Runtime connection (restricted app_user role)
DATABASE_URL=postgres://app_user:change-me@localhost:5432/sitediary
# Migration connection (schema owner; must be superuser or BYPASSRLS, e.g. Railway postgres)
MIGRATION_DATABASE_URL=postgres://postgres:change-me@localhost:5432/sitediary
# Password that migrations set on the app_user role (must match DATABASE_URL)
APP_DB_PASSWORD=change-me
# Better Auth secret: at least 32 random characters (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# Public origin of the web app, no trailing slash (auth links, cookies, Origin checks)
APP_BASE_URL=http://localhost:5173
# Comma-separated emails allowed to self-sign-up as platform admins (may be empty)
PLATFORM_ADMIN_EMAILS=
